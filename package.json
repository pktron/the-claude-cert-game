{
  "name": "claude-cert-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.12.4",
  "description": "The Claude Cert Game — swipe-to-learn study app for the Claude Certified Architect certification",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "audit:content": "node scripts/audit-decks.mjs",
    "grounding:content": "node scripts/check-grounding.mjs",
    "quotes": "node scripts/add-quotes.mjs --apply",
    "shuffle:keys": "node scripts/shuffle-keys.mjs --apply",
    "extract:pdf": "powershell -ExecutionPolicy Bypass -File scripts/extract-pdf.ps1 -Slice",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:content && pnpm audit:content && pnpm grounding:content && pnpm build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.6.2",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.12.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.3"
  }
}
